{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DiskCreate",
  "type": "object",
  "required": ["description", "disk_backend", "name", "size"],
  "properties": {
    "description": { "type": "string" },
    "name": { "type": "string" },
    "size": { "type": "integer", "format": "uint64" },
    "disk_backend": { "$ref": "#/definitions/DiskBackend" }
  },
  "definitions": {
    "DiskBackend": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["local"] }
          }
        },
        {
          "type": "object",
          "required": ["type", "disk_source"],
          "properties": {
            "type": { "type": "string", "enum": ["distributed"] },
            "disk_source": { "$ref": "#/definitions/DiskSource" }
          }
        }
      ]
    },
    "DiskSource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "block_size"],
          "properties": {
            "type": { "type": "string", "enum": ["blank"] },
            "block_size": { "type": "integer", "format": "int64" }
          }
        },
        {
          "type": "object",
          "required": ["type", "snapshot_id"],
          "properties": {
            "type": { "type": "string", "enum": ["snapshot"] },
            "snapshot_id": { "type": "string", "format": "uuid" },
            "read_only": { "type": "boolean", "default": false }
          }
        },
        {
          "type": "object",
          "required": ["type", "image_id"],
          "properties": {
            "type": { "type": "string", "enum": ["image"] },
            "image_id": { "type": "string", "format": "uuid" },
            "read_only": { "type": "boolean", "default": false }
          }
        },
        {
          "type": "object",
          "required": ["type", "block_size"],
          "properties": {
            "type": { "type": "string", "enum": ["importing_blocks"] },
            "block_size": { "type": "integer", "format": "int64" }
          }
        }
      ]
    }
  }
}
